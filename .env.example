# ---- LLM (server-side only, never exposed to the browser) ----
# Any OpenAI-compatible provider works. Changing provider is a .env edit, not a code change.
# Examples: openai | groq | deepseek | openrouter
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional. Defaults per provider (see backend/settings.py).
# LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45

# Max tool-calling rounds per user turn (loop safety valve).
MAX_TOOL_ROUNDS=5

# Comma separated list of allowed origins for local development.
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (read by the Next.js route handler, server-side only) ----
# Local default is http://127.0.0.1:8000 ; set this on Vercel to the deployed backend URL.
BACKEND_URL=http://127.0.0.1:8000
